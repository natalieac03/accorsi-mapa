# ACQR — produção. Copie para .env.production e preencha.
# Este arquivo NUNCA vai para o git (já coberto pelo .gitignore).

# ---------------------------------------------------------------- domínio
# Domínio público. O Caddy pede certificado do Let's Encrypt sozinho.
SITE_ADDRESS=painel.exemplo.org
# Mesmo host, sem esquema nem porta: alimenta o TrustedHostMiddleware da API.
SITE_HOST=painel.exemplo.org
ACME_EMAIL=tecnologia@exemplo.org

# ------------------------------------------------------------------ banco
POSTGRES_DB=acqr
POSTGRES_USER=acqr
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- sessão
# openssl rand -hex 32   (mínimo 48 caracteres; a API recusa subir com
# segredo curto ou contendo "change", "development", "substitua")
SESSION_SECRET=
SESSION_HOURS=8
COOKIE_DOMAIN=

# Vazio de propósito: SPA e API na mesma origem dispensam CORS.
# Só preencha se for servir o frontend em outro domínio — e leia antes o
# comentário no topo do Caddyfile sobre SameSite.
CORS_ORIGINS=

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ------------------------------------------------------------ Google Maps
# Esta chave fica VISÍVEL no bundle entregue ao navegador. Restrinja por
# referenciador HTTP (https://painel.exemplo.org/*) e habilite apenas
# Maps JavaScript API, Places API e Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# "api" persiste cadastros no backend; "demo" usa os 306 registros sintéticos.
VITE_REGISTRATIONS_MODE=api
