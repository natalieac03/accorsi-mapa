APP_ENV=development
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_48_OU_MAIS_CARACTERES
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DOCS_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Agente de perguntas sobre os dados (opcional).
# Sem OPENROUTER_API_KEY o app sobe normalmente: /agent/status devolve
# enabled=false e /agent/chat devolve 503. Nada mais é afetado.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Alternativas com o mesmo contrato de tool calling:
# deepseek/deepseek-v4-flash-0731, openai/gpt-5.6-luna, anthropic/claude-sonnet-5
AGENT_MODEL=google/gemini-3.6-flash
AGENT_MAX_MESSAGES=30
AGENT_MAX_CHARS=24000
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_REQUESTS=20
AGENT_WINDOW_MINUTES=10
