VITE_GOOGLE_MAPS_API_KEY=cole_sua_chave_aqui
VITE_GOOGLE_MAPS_MAP_ID=
VITE_AUTH_REQUIRED=true
# Deixe /api/v1 no desenvolvimento: o Vite encaminha para localhost:8000.
VITE_API_BASE_URL=/api/v1
# "demo" usa somente cadastros sintéticos locais; "api" ativa persistência real.
VITE_REGISTRATIONS_MODE=demo

# Modo demonstração: com este e-mail definido, a tela de login pede APENAS
# a senha (o e-mail vai junto, fixo). Não é atalho: a senha continua sendo
# conferida contra o hash no banco. Deixe vazio em instalação real.
VITE_DEMO_EMAIL=
